# ==============================================================
#  Copia este archivo como ".env" y completa tus valores.
#  ¡NUNCA subas el archivo .env a GitHub! (ya está en .gitignore)
# ==============================================================

PORT=3000
NODE_ENV=development

# --------------------------------------------------------------
#  BASE DE DATOS - SUPABASE
#  Supabase → tu proyecto → botón "Connect" (arriba)
#  → Connection String → Method: "Session pooler" → copiar la URI
#
#  Formato:
#  postgresql://postgres.TU_PROJECT_REF:TU_CONTRASEÑA@aws-X-REGION.pooler.supabase.com:5432/postgres
#
#  • Reemplaza [YOUR-PASSWORD] por tu contraseña real (¡sin los corchetes!)
#  • Si la contraseña tiene símbolos, codifícalos:  @ → %40   # → %23   / → %2F   : → %3A   ? → %3F
#  • NO uses la "Direct connection" (db.xxxx.supabase.co): solo funciona con IPv6
# --------------------------------------------------------------
DATABASE_URL=postgresql://postgres.TU_PROJECT_REF:TU_CONTRASEÑA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Conexiones simultáneas a la BD (el plan gratis de Supabase tiene un límite bajo)
DB_POOL_MAX=5

# (Opcional, más seguro) Ruta al certificado raíz de Supabase para VERIFICAR el servidor.
# Descárgalo en: Project Settings → Database → SSL Configuration → Download certificate
# DATABASE_SSL_CA=./certs/prod-ca-2021.crt

# --------------------------------------------------------------
#  SESIÓN
#  Clave secreta para firmar los tokens (mínimo 32 caracteres, aleatoria).
#  Genera una con:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# --------------------------------------------------------------
JWT_SECRET=pega_aqui_tu_clave_generada
JWT_EXPIRES_IN=2h
